rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Yardımcı Fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Sadece resim dosyalarına izin ver ve boyutu sınırla (5MB)
    function isImageAndSmall() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024;
    }

    // Kullanıcı Avatarları
    match /avatars/{userId}/{allPaths=**} {
      // Herkes okuyabilir (Profilde görünmesi için), sadece sahibi yazabilir
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImageAndSmall();
    }

    // Kullanıcıya Özel Diğer Dosyalar
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Statik ve Genel İçerikler (Sadece Admin yazabilir)
    match /public/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Sadece Console üzerinden veya Admin SDK ile
    }
  }
}
